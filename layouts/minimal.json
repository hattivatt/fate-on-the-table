{
  "format": "fate-on-the-table.layout",
  "version": 1,
  "id": "minimal",
  "name": "Minimal",
  "description": "Only the character name, portrait and aspects.",
  "anchor": {
    "element": "portrait",
    "point": "topLeft"
  },
  "scale": 1,
  "canvas": {
    "origin": {
      "x": -150,
      "y": -200
    },
    "size": {
      "width": 659,
      "height": 450
    },
    "sizePolicy": {
      "mode": "content",
      "minimum": {
        "width": 659,
        "height": 443
      },
      "overflow": "expand"
    }
  },
  "background": {
    "enabled": true,
    "fill": {
      "color": "#ffffff",
      "alpha": 1
    },
    "texture": {
      "source": "@setting.backgroundTexture",
      "whenEmpty": "fill"
    },
    "layer": {
      "elevation": -10,
      "sort": -1000
    }
  },
  "bounds": {
    "enabled": true,
    "rect": "canvas",
    "stroke": {
      "width": 1,
      "color": "#000000",
      "alpha": 0.2
    },
    "layer": {
      "elevation": 10,
      "sort": 1000
    }
  },
  "elements": [
    {
      "id": "name",
      "type": "drawing",
      "rect": {
        "x": 0,
        "y": 0,
        "width": 659,
        "height": 28
      },
      "content": {
        "resolver": "@name",
        "mode": "value"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 26,
        "fontWeight": 800,
        "textColor": "#000000",
        "textAlign": "center",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "sizing": {
        "width": "canvas"
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    },
    {
      "id": "portrait",
      "type": "tile",
      "rect": {
        "x": 150,
        "y": 175,
        "width": 270,
        "height": 270
      },
      "content": {
        "resolver": "@portrait",
        "mode": "image"
      },
      "style": {
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    },
    {
      "id": "aspectsHeader",
      "type": "drawing",
      "rect": {
        "x": 325,
        "y": 33,
        "width": 300,
        "height": 68
      },
      "content": {
        "resolver": "@headerAspects",
        "mode": "value"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 20,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "center",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    },
    {
      "id": "stressTrackNames",
      "type": "drawing",
      "rect": {
        "x": 20,
        "y": 320,
        "width": 280,
        "height": 24
      },
      "content": {
        "resolver": "@stressTrackNames",
        "mode": "rows"
      },
      "repeat": {
        "axis": "y",
        "pitch": 64,
        "itemHeight": 24,
        "direction": "forward"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 16,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "left",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    },
    {
      "id": "stressBoxRows",
      "type": "drawing",
      "rect": {
        "x": 20,
        "y": 348,
        "width": 16,
        "height": 16
      },
      "content": {
        "resolver": "@stressBoxRows",
        "mode": "boxRow"
      },
      "repeat": {
        "axis": "y",
        "pitch": 64,
        "itemHeight": 32,
        "direction": "forward"
      },
      "layer": {
        "elevation": 20,
        "sort": 2000
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 12,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "center",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 1,
          "color": "#000000",
          "alpha": 1
        }
      }
    },
    {
      "id": "consequencesHeader",
      "type": "drawing",
      "rect": {
        "x": 418,
        "y": 290,
        "width": 210,
        "height": 20
      },
      "content": {
        "resolver": "@consequencesHeader",
        "mode": "value"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 16,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "left",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    },
    {
      "id": "consequenceCostRows",
      "type": "drawing",
      "rect": {
        "x": 377,
        "y": 330,
        "width": 260,
        "height": 20
      },
      "content": {
        "resolver": "@consequenceCostRows",
        "mode": "rows"
      },
      "repeat": {
        "axis": "y",
        "pitch": 40,
        "itemHeight": 20,
        "direction": "forward"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 12,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "left",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 20,
        "sort": 2000
      }
    },
    {
      "id": "el_3i03bm",
      "type": "drawing",
      "rect": {
        "x": 320,
        "y": 100,
        "width": 320,
        "height": 120
      },
      "content": {
        "resolver": "@shortAspects",
        "mode": "value"
      },
      "style": {
        "fontFamily": "Montserrat",
        "fontSize": 18,
        "fontWeight": 400,
        "textColor": "#000000",
        "textAlign": "center",
        "verticalAlign": "top",
        "fill": {
          "type": "none",
          "color": "#ffffff",
          "alpha": 0
        },
        "stroke": {
          "width": 0,
          "color": "#000000",
          "alpha": 0
        }
      },
      "layer": {
        "elevation": 0,
        "sort": 0
      }
    }
  ]
}
